<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageIcon>abeja.ico</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ZumbidoJao.Tests</_Parameter1>
    </AssemblyAttribute>
    <Content Include="abeja.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>\</PackagePath>
    </Content>
    <None Include="..\scripts\Uninstall-ZumbidoJao.ps1" Link="Uninstall-ZumbidoJao.ps1">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <None Include="..\scripts\Install-ZumbidoJaoFirewall.ps1" Link="Install-ZumbidoJaoFirewall.ps1">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <None Include="..\scripts\Rollback-ZumbidoJao.ps1" Link="Rollback-ZumbidoJao.ps1">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Si deseas usar messenger.wav o un icono personalizado, añádelos al proyecto y configura CopyToOutputDirectory=PreserveNewest -->

</Project>