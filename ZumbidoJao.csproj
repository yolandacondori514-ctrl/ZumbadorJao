<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageIcon>abeja.ico.ico</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="bin\Release\net10.0-windows\abeja.ico">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <!-- Si deseas usar messenger.wav o un icono personalizado, añádelos al proyecto y configura CopyToOutputDirectory=PreserveNewest -->

</Project>